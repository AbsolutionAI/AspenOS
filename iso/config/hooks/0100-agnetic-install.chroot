#!/bin/sh
# live-build hook: install Starship OS after base system
set -e

echo "=== Starship OS ISO — Custom Hook ==="

# Install Ollama (pinned; install.sh honors OLLAMA_VERSION)
curl -fsSL https://ollama.com/install.sh | OLLAMA_VERSION="0.31.2" sh

# Install NATS
NATS_VERSION="2.14.3"
curl -fsSL "https://github.com/nats-io/nats-server/releases/download/v${NATS_VERSION}/nats-server-v${NATS_VERSION}-linux-amd64.tar.gz" | tar xz -C /usr/local/bin --strip-components=1 nats-server-v${NATS_VERSION}-linux-amd64/nats-server

# Create agnetic user
useradd --system --no-create-home --shell /usr/sbin/nologin --comment "Starship OS" agnetic || true
useradd --system --no-create-home --shell /usr/sbin/nologin --comment "NATS" nats || true

# Create directories (starship primary, legacy agnetic compat symlinks)
# NB: plain sh (no brace expansion) — hook runs under dash in live-build
mkdir -p /opt/starship/bin /opt/starship/lib/starship /opt/starship/venv
mkdir -p /etc/starship/nats
mkdir -p /var/lib/starship/nats /var/lib/starship/message-history
mkdir -p /var/log/starship

# Transitional Alpha 2.1 dual-root (legacy agnetic paths), mirrors install-daemon.sh
ln -sfn /opt/starship /opt/agnetic
ln -sfn /opt/starship/lib/starship /opt/starship/lib/agnetic
ln -sfn /etc/starship /etc/agnetic
ln -sfn /var/lib/starship /var/lib/agnetic
ln -sfn /var/log/starship /var/log/agnetic

# Create Python venv
python3 -m venv /opt/starship/venv
/opt/starship/venv/bin/pip install --upgrade pip -q
/opt/starship/venv/bin/pip install nats-py aiohttp httpx PyYAML -q

# Set ownership
chown -R agnetic:agnetic /opt/starship /etc/starship /var/lib/starship /var/log/starship
chown -R nats:nats /var/lib/starship/nats

echo "=== Starship OS ISO — Hook Complete ==="
