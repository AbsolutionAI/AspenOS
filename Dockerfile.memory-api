# ABS Memory API Dockerfile (Python)
FROM python:3.11-alpine

RUN apk add --no-cache \
    sqlite \
    tzdata \
    ca-certificates

WORKDIR /app

# Copy entire services directory
COPY services/ ./services/

# Ensure proper Python path
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV PORT=8080
ENV ABS_MEMORY_DB=/data/abs_memory.db

EXPOSE 8080

CMD ["python", "/app/services/memory-api.py"]