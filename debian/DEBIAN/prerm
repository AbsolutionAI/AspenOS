#!/bin/bash
# agnetic-os prerm — called before package files are removed
set -e

case "$1" in
    upgrade|failed-upgrade)
        # Keep services running during an upgrade; postinst restarts them
        # after the new files are unpacked. Avoids downtime on dpkg -i.
        echo "Upgrade in progress — leaving services running"
        exit 0
        ;;
    remove|purge|*)
        ;;
esac

echo "Stopping Starship OS services..."

if command -v systemctl &>/dev/null; then
    for unit in agnetic-dashboard agnetic-message-history agnetic-status-bridge \
                agnetic-agent@proxy agnetic-agent@romi agnetic-agent@ergo \
                agnetic-staragent agnetic-nats; do
        systemctl stop "$unit.service" 2>/dev/null || true
        systemctl disable "$unit.service" 2>/dev/null || true
    done
    echo "[OK] Services stopped and disabled"
fi
