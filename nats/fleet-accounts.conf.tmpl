# Starship OS — multi-tenant NATS accounts (generated)
# Materialized by scripts/gen-nats-accounts.sh
# DO NOT commit the materialized file with real secrets.
#
# Accounts:
#   $SYS            — system
#   STARSHIP_OPS    — full mesh (ops profile / plant-alpha)
#   STARSHIP_EDGE   — edge plant (limited)
#   STARSHIP_RANGE  — red/blue range (isolated)
#   STARSHIP_TELEM  — telemetry publishers only
#
# aspen.* ACLs (H-013 / ADR-0007): the aspen.sentinel.*, aspen.authz.*,
# aspen.fleet.* and aspen.safety.* namespaces are guarded per role. ops is the
# trusted mesh/sentinel host; edge/range roles get scoped positive access;
# telemetry stays publish-only. starship.* / agnetic.* allowances are unchanged.

port: 4222
host: "0.0.0.0"
http_port: 8222

jetstream {
  store_dir: "/var/lib/starship/nats"
  max_memory_store: 512MB
  max_file_store: 4GB
}

max_payload: 8MB
max_connections: 256
debug: false
trace: false

# Optional TLS — firstboot/gen-nats-tls.sh writes tls/ and sets STARSHIP_NATS_TLS=1
# Uncomment or include when TLS material exists:
# include ./tls/tls.conf.snippet

# Resolve system account
system_account: SYS

accounts {
  SYS {
    users: [
      {user: "sys", password: "__SYS_PASS__"}
    ]
  }

  STARSHIP_OPS {
    jetstream: enabled
    users: [
      {user: "ops", password: "__OPS_PASS__"
       permissions: {
         publish: {
           allow: [
             "starship.>"
             "agnetic.>"
             "aspen.sentinel.>"
             "aspen.authz.>"
             "aspen.fleet.>"
             "aspen.safety.>"
           ]
         }
         subscribe: {
           allow: [
             "starship.>"
             "agnetic.>"
             "aspen.sentinel.>"
             "aspen.authz.>"
             "aspen.fleet.>"
             "aspen.safety.>"
           ]
         }
       }
      }
    ]
    exports: [
      {stream: "starship.fleet.>"}
      {stream: "starship.agent.>"}
      {stream: "starship.telemetry.>"}
      {stream: "agnetic.fleet.>"}
      {stream: "agnetic.agent.>"}
      {stream: "agnetic.telemetry.>"}
      {stream: "aspen.sentinel.>"}
      {stream: "aspen.authz.>"}
    ]
    imports: [
      {stream: {account: "STARSHIP_EDGE", subject: "starship.fleet.>"}}
      {stream: {account: "STARSHIP_EDGE", subject: "agnetic.fleet.>"}}
      {stream: {account: "STARSHIP_TELEM", subject: "starship.telemetry.>"}}
      {stream: {account: "STARSHIP_TELEM", subject: "agnetic.telemetry.>"}}
      {stream: {account: "STARSHIP_EDGE", subject: "aspen.fleet.>"}}
      {stream: {account: "STARSHIP_EDGE", subject: "aspen.edge.>"}}
      {stream: {account: "STARSHIP_EDGE", subject: "aspen.safety.estop"}}
    ]
  }

  STARSHIP_EDGE {
    jetstream: enabled
    users: [
      {user: "edge", password: "__EDGE_PASS__"
       permissions: {
         publish: {
           allow: [
             "starship.fleet.heartbeat"
             "starship.fleet.register"
             "starship.fleet.status"
             "starship.agent.proxy.>"
             "starship.telemetry.>"
             "agnetic.fleet.heartbeat"
             "agnetic.fleet.register"
             "agnetic.fleet.status"
             "agnetic.agent.proxy.>"
             "agnetic.telemetry.>"
             "aspen.fleet.>"
             "aspen.edge.>"
             "aspen.safety.estop"
             "aspen.safety.authorize_clear"
           ]
         }
         subscribe: {
           allow: [
             "starship.fleet.>"
             "starship.fleet.ops.>"
             "starship.agent.proxy.>"
             "agnetic.fleet.>"
             "agnetic.agent.proxy.>"
             "aspen.fleet.>"
             "aspen.edge.>"
             "aspen.safety.estop"
             "aspen.safety.clear"
             "aspen.sentinel.>"
           ]
         }
       }
      }
    ]
    exports: [
      {stream: "starship.fleet.>"}
      {stream: "agnetic.fleet.>"}
      {stream: "aspen.fleet.>"}
      {stream: "aspen.edge.>"}
      {stream: "aspen.safety.estop"}
    ]
    imports: [
      {stream: {account: "STARSHIP_OPS", subject: "aspen.sentinel.>"}}
    ]
  }

  STARSHIP_RANGE {
    # Isolated red/blue plant — no imports from OPS/EDGE
    users: [
      {user: "red", password: "__RED_PASS__"
       permissions: {
         publish: {
           allow: [
             "starship.agent.proxy.>"
             "starship.fleet.heartbeat"
             "agnetic.agent.proxy.>"
             "agnetic.fleet.heartbeat"
             "aspen.fleet.node.register"
             "aspen.fleet.node.heartbeat"
             "aspen.edge.>"
           ]
         }
         subscribe: {
           allow: [
             "starship.agent.proxy.>"
             "starship.fleet.exercise"
             "agnetic.agent.proxy.>"
             "agnetic.fleet.exercise"
             "aspen.fleet.>"
             "aspen.safety.estop"
           ]
         }
       }
      }
      {user: "blue", password: "__BLUE_PASS__"
       permissions: {
         publish: {
           allow: [
             "starship.agent.>"
             "starship.fleet.heartbeat"
             "starship.fleet.status"
             "agnetic.agent.>"
             "agnetic.fleet.heartbeat"
             "agnetic.fleet.status"
             "aspen.fleet.>"
             "aspen.edge.>"
           ]
         }
         subscribe: {
           allow: ["starship.>", "agnetic.>", "aspen.fleet.>", "aspen.safety.estop", "aspen.sentinel.fleet.overview"]
         }
       }
      }
    ]
  }

  STARSHIP_TELEM {
    users: [
      {user: "telem", password: "__TELEM_PASS__"
       permissions: {
         publish: {
           allow: ["starship.telemetry.>", "agnetic.telemetry.>"]
         }
         subscribe: {
           allow: []
         }
       }
      }
    ]
    exports: [
      {stream: "starship.telemetry.>"}
      {stream: "agnetic.telemetry.>"}
    ]
  }
}
