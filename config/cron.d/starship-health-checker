# Starship OS Agent Health Checker — runs every 2 minutes
# Install: cp this file to /etc/cron.d/starship-health-checker
# Requires: python3 (venv at /opt/starship/venv), aiohttp, pyyaml
*/2 * * * * root /opt/starship/venv/bin/python3 /opt/starship/lib/starship/scripts/agent-health-checker.py --once >> /var/log/starship-health.log 2>&1
